    "def clean_multi_select(value):\n",
    "    if pd.isna(value):\n",
    "        return []\n",
    "\n",
    "    splitted = str(value).split(\";\")\n",
    "\n",
    "    cleaned = []\n",
    "    for p in splitted:\n",
    "        clean_text(p)\n",
    "        if p:\n",
    "            cleaned.append(p)\n",
    "\n",
    "    cleaned = list(set(cleaned))\n",
    "\n",
    "    cleaned.sort()\n",
    "\n",
    "    return cleaned"
   ],
