    "# Alle Spalten mit nicht numerischen Werten in einen DataFrame packen\n",
    "category_columns = df.select_dtypes(include=[\"object\"]).columns.tolist()\n",
    "\n",
    "print(\"Anzahl numerischer Spalten:\", len(numeric_columns)) #Anzahl: 42\n",
