    "# 1. Daten einlesen\n",
    "df = pd.read_csv(\"stack-overflow-developer-survey-2025/survey_results_public_without_SO.csv\")\n",
    "\n",
    "df[col].value_counts()[df[col].value_counts() > 50].index\n",
    "\n",
    "# 2. Text-/kategorische Spalten finden (object)\n",
    "text_cols = df.select_dtypes(include=[\"object\"]).columns\n",
    "\n",
    "# 3. One-Hot-Encoding auf diese Spalten anwenden\n",
    "#    -> alle Textspalten werden in 0/1-Spalten umgewandelt\n",
    "df_encoded = pd.get_dummies(df, columns=text_cols, dummy_na=True)\n",
    "\n",
    "# 4. Feature-Matrix X bauen (nur numerische Spalten)\n",
    "#    Nach get_dummies sind alle Features numerisch, wir nehmen einfach alles Numerische.\n",
    "X = df_encoded.select_dtypes(include=[\"number\"]).fillna(0)\n",
    "\n",
    "# 5. KMeans-Clustering\n",
    "#    Anzahl Cluster kannst du nach Bedarf anpassen (hier: 8)\n",
    "'''kmeans = KMeans(\n",
    "    n_clusters=8,\n",
    "    random_state=0,\n",
    "    n_init=10\n",
    ")'''\n",
    "\n",
    "mbkm = MiniBatchKMeans(\n",
    "    n_clusters=8,      # wie gehabt\n",
    "    random_state=0,\n",
    "    batch_size=1024,   # typische Batch-Größe, kannst du anpassen\n",
    "    n_init=10,\n",
    "    max_iter=100       # wie oft über alle Batches iteriert wird\n",
    ")\n",
    "\n",
    "# 6. Modell fitten und Cluster-Labels berechnen\n",
    "df_encoded[\"cluster\"] = mbkm.fit_predict(X)\n",
    "\n",
    "# 7. Kurze Auswertung\n",
    "print(df_encoded[\"cluster\"].value_counts())\n",
    "\n",
    "# 8. Optional: Ergebnisse speichern\n",
